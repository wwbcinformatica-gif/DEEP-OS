# ─── Provedores de IA ───────────────────────────────────────────
# Preencha apenas os provedores que pretende usar.

# Groq (gratuito, modelos rápidos)
# https://console.groq.com/keys
GROQ_API_KEY=

# OpenAI (GPT-4, GPT-4o)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter (vários modelos)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenClaude (Claude Sonnet, Haiku)
# https://console.openclaude.ai
OPENCLAUDE_API_KEY=
OPENCLAUDE_BASE_URL=http://localhost:4000/api/v1

# OpenCode
OPENCODE_API_KEY=

# MiMo (Xiaomi) - Gratuito
# https://mimo.mi.com
MIMO_API_KEY=

# ─── Configurações do servidor ──────────────────────────────────
HOST=0.0.0.0
PORT=8000
